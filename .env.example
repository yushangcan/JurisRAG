# 模型决策循环使用已有兼容接口；没有有效 Key 时明确使用规则回退。
RETRIEVAL_MODE=lexical
ENABLE_LLM=true
ENABLE_AGENT=true
INCLUDE_LEGAL_COLLECTION=true

# 使用项目内相对目录，避免旧电脑的绝对路径。
INDEX_DIR=data/index/legal_knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 有限检索与生成预算；旧环境中更大的值会限制到当前上限。
AGENT_MAX_ITERATIONS=3
AGENT_MAX_LLM_CALLS=8
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_REQUEST_TIMEOUT_SECONDS=300
AGENT_MAX_CONCURRENT_REQUESTS=2
AGENT_MAX_QUESTION_CHARS=2000

# 模型决策、检索观察与回答：配置所选供应商。离线回归显式设置 ENABLE_LLM=false。
LLM_PROVIDER=codez
CODEZ_API_KEY=
CODEZ_BASE_URL=https://api-sss.zwenooo.link/v1
CODEZ_MODEL=gpt-6.1-sol
LLM_WIRE_API=responses
LLM_REASONING_EFFORT=max
DISABLE_RESPONSE_STORAGE=true

# 可选 hybrid：安装 requirements-semantic.txt，准备权重后重新建库。
# EMBEDDING_BACKEND=bge_small_zh_v1_5
# EMBEDDING_MODEL_PATH=data/models/fastembed/models--Qdrant--bge-small-zh-v1.5
# EMBEDDING_BATCH_SIZE=64
# RERANKER_BACKEND=bge_reranker_base_onnx
# RERANKER_MODEL_PATH=data/models/bge-reranker-base
