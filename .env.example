# Optional: when set, the online API can ask DeepSeek to write a final answer.
# Leave these empty to run the completely offline retrieval fallback.
ENABLE_LLM=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# 可选：使用通义千问时设置 LLM_PROVIDER=dashscope，并在系统环境中提供 Key。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 数据目录默认使用项目内的相对位置；只有数据放在其他磁盘时才取消注释。
# RAW_LAWS_DIR=data/source/primary_laws
# PROCESSED_MARKDOWN_DIR=data/processed/markdown
# INDEX_DIR=data/index/legal_knowledge
# LEGAL_COLLECTION_SOURCE_DIR=data/source/legal_collection
# LEGAL_COLLECTION_MARKDOWN_DIR=data/processed/legal_collection

# 设为 false 可只处理 primary_laws 中 manifest.json 登记的20份基线语料。
INCLUDE_LEGAL_COLLECTION=true

# 父子切块：父块尽量保持完整法条/章节，超过500字时才生成带80字重叠的子块。
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# API 默认返回5个按 parent_id 去重后的父块证据。
DEFAULT_TOP_K=5

# 中文语义检索。模型文件在首次准备时下载到 data/models，不提交 Git。
EMBEDDING_BACKEND=bge_small_zh_v1_5
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=data/models/fastembed/models--Qdrant--bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=64

# child 级交叉编码器重排；none 可用于消融实验。
RERANKER_BACKEND=bge_reranker_base_onnx
RERANKER_MODEL_PATH=data/models/bge-reranker-base
RERANK_CANDIDATES=20

# 每个召回通道先取 top_k * 8 个候选；RRF_K 越大，融合时不同名次差距越平滑。
HYBRID_CANDIDATE_MULTIPLIER=8
RRF_K=60

# 证据不足时进行二次多路召回；阈值均会写进 retrieval_trace。
ENABLE_MULTI_RECALL=true
RETRY_RERANKER_SCORE=5.0
EVIDENCE_MIN_RERANKER_SCORE=3.0
EVIDENCE_MIN_WEIGHTED_COVERAGE=0.20
EVIDENCE_MIN_CHANNEL_AGREEMENT=2

# 受约束 Agent。MCP Server 默认需要单独运行在 8001 端口。
ENABLE_AGENT=true
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_LLM_CALLS=7
AGENT_MAX_CORRECTIONS=2
AGENT_MAX_CHILD_EVIDENCE=20
AGENT_MAX_PARENT_EVIDENCE=8
AGENT_MAX_CITATIONS=5
# 状态图预算是90秒；端到端预算还要覆盖显式固定RAG降级，但保证整个请求有上限。
AGENT_TIMEOUT_SECONDS=90
AGENT_REQUEST_TIMEOUT_SECONDS=120
# 单次模型调用、固定RAG降级和单次MCP会话各自有更小超时，避免一个依赖吃满总预算。
AGENT_LLM_TIMEOUT_SECONDS=35
AGENT_BASELINE_TIMEOUT_SECONDS=25
AGENT_MCP_TIMEOUT_SECONDS=30
# MCP连接最多尝试2次；连续3次连接失败后熔断30秒，工具/Schema错误不计入熔断。
AGENT_MCP_RETRY_ATTEMPTS=2
AGENT_MCP_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_MCP_CIRCUIT_RECOVERY_SECONDS=30
# 健康探测需要建立MCP会话，但不调用大模型；独立预算避免误用30秒业务超时。
AGENT_HEALTH_TIMEOUT_SECONDS=10
AGENT_NO_PROGRESS_LIMIT=2
AGENT_TOOL_TOP_K=5
# 单机CPU Reranker较重，进程内最多同时处理2个Agent请求；超出时API快速返回503。
AGENT_MAX_CONCURRENT_REQUESTS=2
AGENT_MAX_QUESTION_CHARS=2000
